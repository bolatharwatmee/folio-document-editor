# Local API server
PORT=3000

# SQLite file. In deployment this must point at a durable volume.
DATABASE_PATH=./data/folio.db

# Set to the public origin in production, e.g. https://folio.example.com
# Used for the cross-origin write check. Leave blank locally.
APP_ORIGIN=

# Defaults to true when NODE_ENV=production. Set false only for local production testing over HTTP.
COOKIE_SECURE=
